# Each line is a named parameter set: <name> <benchmark CLI flags>.
# Flags may embed bash arithmetic using $((ranks)) and $((threads)), which are
# substituted with the actual rank/thread counts of each experiment (from
# config/experiments.cfg) at job-generation time. This lets one line scale the
# problem size to whatever resource configuration the experiment requests,
# instead of needing one hardcoded line per rank/thread combination.
weak_x -nx $((20 * ranks)) -ny $((20 + threads)) -nz 20
weak_z -nx 20 -ny $((20 + threads)) -nz $((20 * ranks))
