# Every dimension is multiplied by 20 by the LAMMPS script. Don't make the parameter list look like the name unless you want to run a really big test.
weak_x -sf omp -in in.lj -var x $((ranks)) -var y 1 -var z 1
weak_x5 -sf omp -in in.lj -var x $((5 * ranks)) -var y 5 -var z 5
weak_x_scaled -sf omp -in in.lj -var x $((ranks)) -var y $((threads)) -var z 1
weak_x5_scaled -sf omp -in in.lj -var x $((5 * ranks)) -var y $((5 * threads)) -var z 5
